{
  "name": "gamma-meridian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run compile && next dev",
    "build": "npm run compile && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:backend": "eslint src/server src/app/api scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --expose-gc --conditions=react-server --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "ingest:regulation": "node --conditions=react-server --import tsx scripts/ingest-regulatory-source.ts",
    "seed:development": "node --conditions=react-server --import tsx scripts/seed-development.ts",
    "smoke:backend": "node --conditions=react-server --import tsx scripts/smoke-backend-api.ts",
    "compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy url baseLocale",
    "postinstall": "npm run compile"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@libsql/client": "^0.17.4",
    "@next/env": "^16.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
