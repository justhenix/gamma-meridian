# Meridian server environment template
# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or prefix any secret below with NEXT_PUBLIC_.

# -----------------------------------------------------------------------------
# Database — required
# -----------------------------------------------------------------------------
# Remote Turso/libSQL database:
TURSO_DATABASE_URL="libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
# Local development alternative (a remote token is not needed):
# TURSO_DATABASE_URL="file:meridian.db"
# TURSO_AUTH_TOKEN=""

# HMAC secret used to hash guest-intake bearer tokens. Required.
# Generate a unique value of at least 32 random bytes per environment.
# Example: openssl rand -base64 48
INTAKE_TOKEN_PEPPER="replace-with-a-long-random-secret"

# Independent HMAC secret for opaque authenticated session tokens and OTP hashes.
# Generate another unique value of at least 32 random bytes per environment.
AUTH_TOKEN_PEPPER="replace-with-a-different-long-random-secret"

# -----------------------------------------------------------------------------
# Transactional verification email — SumoPod SMTP (production)
# -----------------------------------------------------------------------------
SUMOPOD_SMTP_HOST="smtp.sumopod.com"
SUMOPOD_SMTP_PORT="465"
SUMOPOD_SMTP_SECURE="true"
SUMOPOD_SMTP_USER="replace-with-sumopod-smtp-username"
SUMOPOD_SMTP_PASSWORD="replace-with-sumopod-smtp-password"
SUMOPOD_FROM_NAME="Meridian Tax"
SUMOPOD_FROM_EMAIL="verify@example.com"

# Comma-separated staff emails authorized to use the separate staff OTP login.
MERIDIAN_STAFF_EMAILS="staff@example.com"

# -----------------------------------------------------------------------------
# B.AI / Qwen — BAI_API_KEY is required for live AI answers
# -----------------------------------------------------------------------------
# The backend remains fail-closed when the key is absent or invalid.
BAI_API_KEY="replace-with-your-bai-api-key"
BAI_BASE_URL="https://api.b.ai/v1"
BAI_MODEL="qwen3.8-flash"
BAI_TIMEOUT_MS="15000"
BAI_MAX_OUTPUT_TOKENS="1200"

# -----------------------------------------------------------------------------
# AI release policy — production-safe defaults
# -----------------------------------------------------------------------------
# Additional accountant-approved topic keys allowed to reach the AI answer step.
# The general first-line assistant topic is always enabled; hard-risk intent still
# fails closed before the provider and every published answer still needs approved sources.
MERIDIAN_AI_SAFE_TOPICS="general_tax_business"
# Development fixture example only; never treat it as real law:
# MERIDIAN_AI_SAFE_TOPICS="synthetic_safe_general"

# Only set true after Meridian approves the no-additional-cost promise.
MERIDIAN_EXPERT_ESCALATION_FREE="false"

# -----------------------------------------------------------------------------
# Development and manual operations
# -----------------------------------------------------------------------------
# Development-only HTTP plumbing while real authentication is not integrated.
# Keep false by default. It is forcibly disabled when NODE_ENV=production.
MERIDIAN_ENABLE_SYNTHETIC_API="false"

# Existing active admin user UUID used by `npm run ingest:regulation`.
# Required only when running the manual ingestion command.
MERIDIAN_INGEST_ACTOR_USER_ID=""
